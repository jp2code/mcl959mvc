@{
    var isAuth = User.Identity?.IsAuthenticated ?? false;
}
<div id="chatBox" style="position:fixed;bottom:10px;right:10px;width:300px;background:#113355;border-radius:6px;padding:8px;font-size:.9rem;z-index:9999;">
    <div style="display:flex;align-items:center;gap:6px;">
        <strong>Member Assistant</strong>
        <span style="font-size:.7rem;color:#ccc;">@(isAuth ? "" : "Guest")</span>
        <button id="chatMinBtn" type="button"
                style="margin-left:auto;background:#BDBDBD;color:#102132;border:none;width:26px;height:26px;line-height:24px;border-radius:4px;font-weight:700;cursor:pointer;">
            x
        </button>
    </div>
    <div id="chatInner">
        <div id="chatLog" style="height:160px;overflow-y:auto;background:#0b2a4d;padding:6px;margin:4px 0;border-radius:4px;"></div>
        <form id="chatForm">
            <input id="chatInput" class="form-control form-control-sm" placeholder="Ask a question..." autocomplete="off"/>
        </form>
    </div>
    @if (!isAuth)
    {
        <div style="margin-top:4px;font-size:.7rem;color:#ddd;">
            You are not logged in. I can only answer login / registration questions.
            <br /><a href="/Identity/Account/Register" style="color:#FFD700;">Register</a> |
            <a href="/Identity/Account/Login" style="color:#FFD700;">Login</a>
        </div>
    }
</div>
<script>
(function() {
  const form = document.getElementById('chatForm');
  const input = document.getElementById('chatInput');
  const log = document.getElementById('chatLog');
  const minBtn = document.getElementById('chatMinBtn');
  const inner = document.getElementById('chatInner');
  let minimized = false;
  const isAuth = @(User.Identity?.IsAuthenticated ?? false ? "true" : "false");

  function append(role, text, isHtml) {
      const div = document.createElement('div');
      div.className = 'chat-msg';
      const roleSpan = document.createElement('b');
      roleSpan.textContent = role + ': ';
      const bodySpan = document.createElement('span');
      bodySpan.className = 'chat-msg-body';
      if (isHtml) {
          bodySpan.innerHTML = text;   // render HTML
      } else {
          bodySpan.textContent = text; // show plain text
      }
      div.appendChild(roleSpan);
      div.appendChild(bodySpan);
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
  }

  append("Assistant",
      isAuth
        ? "Hello! Ask about membership, meetings, or how to register."
        : "Hi! Ask:\n'How do I register?'\n'How do I log in?'\nLog in for full answers.",
      false);

  form.addEventListener('submit', async e => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      append("You", q, false);
      input.value = "";
      const url = isAuth ? '/api/chat/ask' : '/api/chat/public';
      const res = await fetch(url, {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ question: q })
      });
      if (!res.ok) {
          append("Assistant","Please log in for full access.", false);
          return;
      }
      const data = await res.json();
      // Support either IsHtml or isHtml (depending on serializer)
      const isHtmlFlag = (data.isHtml === true) || (data.IsHtml === true);
      append("Assistant", data.answer, isHtmlFlag);
      if (data.suggestions?.length) {
          append("Assistant", "Try:\n" + data.suggestions.join("\n"), false);
      }
  });

  minBtn.addEventListener('click', () => {
      const host = document.getElementById('chatHost');
      if (host) {
          host.style.display = 'none';
          const openBtn = document.getElementById('openAssistant');
          if (openBtn) {
              openBtn.textContent = 'Open Assistant';
          }
          return;
      }
      // Fallback: hode only the popup box
      const box = document.getElementById('chatBox');
      if (box) {
          box.style.display = 'none';
      }
  });
})();
</script>
<style>
#chatLog .chat-msg-body { white-space: pre-line; }
</style>
