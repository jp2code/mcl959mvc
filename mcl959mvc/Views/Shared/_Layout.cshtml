@using System.Text.Json
@{
    // Safely handle possible nulls in ModelState
    var modelState = ViewData.ModelState ?? new Microsoft.AspNetCore.Mvc.ModelBinding.ModelStateDictionary();
    var errorDict = modelState
        .Where(x => x.Value != null && x.Value.Errors.Any())
        .ToDictionary(
            x => x.Key,
            x => x.Value!.Errors.Select(e => e.ErrorMessage).ToList()
        );

    // Compose the popup message if there are errors
    var popupMessage = TempData["PopupMessage"] as string;
    if (errorDict.Count > 0)
    {
        var allErrors = string.Join("<br/>", errorDict.SelectMany(kvp => kvp.Value));
        if (!string.IsNullOrEmpty(popupMessage))
        {
            popupMessage += "<hr/>" + allErrors;
        }
        else
        {
            popupMessage = allErrors;
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>mcl959 @ViewData["Title"]</title>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mcl959.css" asp-append-version="true" />
    <link rel="preload" href="/css/mcl959.woff" as="font" type="font/woff2" crossorigin>
</head>
<body>
    <header>
        @{
            string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        }
        <div class="logo desktop-logo"></div>
        <div class="head">
            <h1 style="z-index: 3;">
                Marine Corps League<br />
                Longview Detachment 959<br />
                1512 Alpine Rd, Longview, TX 75601
            </h1>
        </div>
        <div class="login">@await Html.PartialAsync("_LoginPartial")</div>
        <div class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li id="miHome" class="nav-item @(currentController == "Home" && currentAction != "About" ? "selected" : "")">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">MCL959</a>
                        </li>
                        <li id="miEvent" class="nav-item @(currentController == "Events" ? "selected" : "")">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
                        </li>
                        <li id="miMember" class="nav-item @(currentController == "Roster" ? "selected" : "")">
                            <a class="nav-link" asp-controller="Roster" asp-action="Index">Members</a>
                        </li>
                        <li id="miAbout" class="nav-item @(currentController == "Home" && currentAction == "About" ? "selected" : "")">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li id="miContact" class="nav-item @(currentController == "Messages" ? "selected" : "")">
                            <a class="nav-link" asp-controller="Messages" asp-action="Index">Contact</a>
                        </li>
                        <!-- Add more controllers/actions as needed -->
                    </ul>
                </div>
            </div>
        </div>
    </header>
    <div class="main-content">
        <div class="container">
            <main role="main">
                @RenderBody()
            </main>
            @if (!string.IsNullOrEmpty(popupMessage))
            {
                <div id="popupMessage" class="alert alert-info alert-dismissible fade center-popup" role="alert">
                    @Html.Raw(popupMessage)
                    <button id="popupCloseBtn" type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    </div>
    <div class="logo mobile-logo"></div>
    <footer class="border-top footer text-muted">
        <div class="container">
            Find and like us on Facebook at <a href="https://www.facebook.com/mcl959">Facebook.com/mcl959</a><br />
            &copy; 2025 - mcl959mvc - <a asp-area="" asp-controller="Home" asp-action="About">About</a>
            <div id="showPopupDiv">
                <a href="#" id="showPopupLink">View last Message</a>
            </div><br />
        </div>
    </footer>
    <div class="modal fade" id="entityModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div id="entityModalContent" class="modal-body">
                    <!-- leave empty -->
                </div>
            </div>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function() {
              if (window.__popupInit) return;
              window.__popupInit = true;

              function init() {
                  const modalEl = document.getElementById('entityModal');
                  const contentEl = document.getElementById('entityModalContent');
                  if (!modalEl || !contentEl) return;

                  const modal = new bootstrap.Modal(modalEl, {
                      backdrop: true,
                      keyboard: true
                  });
                  const baseUrl = '@Url.Content("~/")';
                  const currentController = '@(ViewContext.RouteData.Values["controller"] ?? "")';

                  // Global openPopup
                  window.openPopup = async function({
                      controller,
                      action = 'Popup',
                      popupType,
                      id
                  } = {}) {
                      const ctrl = controller || currentController;
                      const qs = new URLSearchParams();
                      if (popupType) qs.set('popupType', popupType);
                      if (id) qs.set('id', id);
                      const url = `${baseUrl}${ctrl}/${action}${qs.toString() ? '?' + qs.toString() : ''}`;

                      const resp = await fetch(url, {
                          credentials: 'same-origin'
                      });
                      contentEl.innerHTML = await resp.text();
                      modal.show();
                  };

                  // Open any popup via data attributes
                  document.addEventListener('click', async (e) => {
                      const a = e.target.closest('[data-popup]');
                      if (!a) return;
                      e.preventDefault();
                      await window.openPopup({
                          controller: a.getAttribute('data-popup-controller') || currentController,
                          action: a.getAttribute('data-popup-action') || 'Popup',
                          popupType: a.getAttribute('data-popup') || '',
                          id: a.getAttribute('data-id') || ''
                      });
                  });

                  // AJAX submit for forms inside the modal (includes photo upload)
                  contentEl.addEventListener('submit', async (e) => {
                      const form = e.target;
                      if (!(form instanceof HTMLFormElement)) return;
                      e.preventDefault();
                      const submitBtn = form.querySelector('[type="submit"]');
                      submitBtn?.setAttribute('disabled', 'disabled');
                      try {
                          // Special-case: Roster photo upload
                          if (form.id === 'photoUploadForm') {
                              const resp = await fetch(form.action, {
                                  method: 'POST',
                                  body: new FormData(form),
                                  credentials: 'same-origin'
                              });
                              const text = await resp.text();
                              const resultDiv = contentEl.querySelector('#uploadResult');
                              if (resultDiv) resultDiv.innerHTML = text;

                              // Cache-bust the displayed photo
                              const img = contentEl.querySelector('img[src*="/photos/"]');
                              if (img) {
                                  const url = new URL(img.getAttribute('src'), window.location.origin);
                                  url.searchParams.set('v', Date.now().toString());
                                  img.setAttribute('src', url.pathname + '?' + url.searchParams.toString());
                              }
                              return;
                          }

                          // Generic AJAX submit (with antiforgery)
                          const formData = new FormData(form);
                          const token =
                              formData.get('__RequestVerificationToken') ||
                              document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                          const resp = await fetch(form.action || window.location.href, {
                              method: (form.method || 'POST').toUpperCase(),
                              body: formData,
                              credentials: 'same-origin',
                              headers: Object.assign(
                                  token ? {
                                      'RequestVerificationToken': token
                                  } : {}, {
                                      'X-Requested-With': 'XMLHttpRequest'
                                  }
                              )
                          });

                          if (resp.redirected) {
                              // fetch already followed the redirect; use the HTML body to refresh the modal
                              const html = await resp.text();
                              contentEl.innerHTML = html;
                              return;
                          }

                          const ct = resp.headers.get('Content-Type') || '';
                          if (ct.includes('application/json')) {
                              const data = await resp.json();
                              if (data.success) {
                                  modal.hide();
                                  location.reload();
                                  return;
                              }
                          }
                          contentEl.innerHTML = await resp.text();

                          // Memorial-specific click delegation
                          contentEl.addEventListener('click', async (e) => {
                              const t = e.target;
                              if (!(t instanceof HTMLElement)) return;

                              if (t.id === 'editDescription') {
                                  e.preventDefault();
                                  const div = contentEl.querySelector('#descriptionDisplay');
                                  const btnEdit = contentEl.querySelector('#editDescription');
                                  const btnSave = contentEl.querySelector('#saveDescription');
                                  const btnCancel = contentEl.querySelector('#cancelEdit');
                                  if (!div || !btnEdit || !btnSave || !btnCancel) return;
                                  btnEdit.style.display = 'none';
                                  btnSave.style.display = '';
                                  btnCancel.style.display = '';
                                  div.setAttribute('contenteditable', 'true');
                                  div.focus();
                              }

                              if (t.id === 'saveDescription' || t.id === 'cancelEdit') {
                                  e.preventDefault();
                                  const save = (t.id === 'saveDescription');
                                  const form = contentEl.querySelector('#editMemorialForm');
                                  const div = contentEl.querySelector('#descriptionDisplay');
                                  if (!form || !div) return;
                                  const descInput = contentEl.querySelector('#descriptionInput');
                                  const saveInput = contentEl.querySelector('#saveInput');
                                  if (descInput && saveInput) {
                                      descInput.value = div.innerHTML;
                                      saveInput.value = save ? 'true' : 'false';
                                  }
                                  const resp = await fetch(form.action, {
                                      method: 'POST',
                                      body: new FormData(form),
                                      credentials: 'same-origin'
                                  });
                                  contentEl.innerHTML = await resp.text();
                              }

                              if (t.classList.contains('delete-comment')) {
                                  e.preventDefault();
                                  if (!confirm('Are you sure you want to delete this comment?')) return;
                                  const id = t.getAttribute('data-id') || t.getAttribute('data-itemid');
                                  const form = contentEl.querySelector('#delete-comment-' + id);
                                  if (!form) return;
                                  const resp = await fetch(form.action, {
                                      method: 'POST',
                                      body: new FormData(form),
                                      credentials: 'same-origin'
                                  });
                                  contentEl.innerHTML = await resp.text();
                              }
                          });
                      } catch (ex) {
                          console.error('Popup form submission error:', ex);
                      } finally {
                          submitBtn?.removeAttribute('disabled');
                      }

                  });
              }
              if (document.readyState === 'loading') {
                  document.addEventListener('DOMContentLoaded', init);
              } else {
                  init();
              }
        });

        document.addEventListener('DOMContentLoaded', () => {
            const popup = document.getElementById('popupMessage');
            const closeBtn = document.getElementById('popupCloseBtn');
            const showLink = document.getElementById('showPopupLink');
            const showLinkContainer = document.getElementById('showPopupDiv');
            let popupTimeout;
            // If no popup is rendered (no TempData), hide the link container
            if (!popup) {
                showLinkContainer?.classList.add('d-none');
                return;
            }
            // Auto-show shortly after load (optional)
            setTimeout(() => popup.classList.add('show'), 10);
            // Manual close
            closeBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                popup.classList.remove('show');
                clearTimeout(popupTimeout);
            });
            // Show last message on demand
            showLink?.addEventListener('click', (e) => {
                e.preventDefault();
                popup.classList.add('show');
                clearTimeout(popupTimeout);
                popupTimeout = setTimeout(() => popup.classList.remove('show'), 20000);
            });
        });
    </script>
</body>
</html>
