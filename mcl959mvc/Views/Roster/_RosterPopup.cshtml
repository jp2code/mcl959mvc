@model mcl959mvc.Models.Roster
@{
    var popupType = (mcl959mvc.Models.PopupType)ViewBag.PopupType;
    bool isAdmin = User.HasClaim("isAdmin", "true");
    var photoPath = Model.HasPhoto ? $"/photos/{Model.Id}.jpg" : "/photos/mcl959bw.jpg";
    var mode = isAdmin ? (ViewBag.Mode as string ?? "Details") : "Details";
    bool isReadOnly = mode is "Details" or "Delete";
    string ShortDate(DateTime? d) => d.HasValue ? d.Value.ToShortDateString() : "";
    // Helpers for date edit values (ISO needed for type="date")
    string IsoDate(DateTime? d) => d.HasValue ? d.Value.ToString("yyyy-MM-dd") : "";
}
<div class="modal-body">
    <div class="container mt-4">
        <div class="card mb-4 shadow-sm roster-card">
            <div class="row g-0">
                <div class="col-md-4 d-flex flex-column align-items-center justify-content-start roster-photo-col">
                    <img src="@photoPath"
                         alt="@Model.GetFullName()"
                         class="img-fluid rounded m-3 roster-photo" />
                    @if (isAdmin && (mode == "Edit" || mode == "Delete"))
                    {
                        <div id="imgUploadDiv" class="w-100 text-center mt-2">
                            <form id="photoUploadForm" enctype="multipart/form-data" method="post" action="/Roster/UploadPhoto/@Model.Id">
                                @Html.AntiForgeryToken()
                                <input type="file" id="photoInput" name="Photo" accept=".jpg,.jpeg,image/jpeg" required class="input-compact" />
                                <button type="submit" class="btn btn-sm btn-secondary mt-2">Change</button>
                            </form>
                            <div id="uploadResult" class="mt-1"></div>
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <div class="card-body pb-2 pt-3">
                        <h2 class="card-title mb-2">@Model.DisplayName</h2>
                        <p class="mb-1"><strong>Created:</strong> @ShortDate(Model.CreatedDate)</p>
                    </div>
                </div>
                <hr class="roster-divider" />
                <div class="col-md-12">
                    <div class="card-body pt-2">
                        <form id="rosterPopup" asp-controller="Roster" asp-action="@mode" method="post">
                            @Html.AntiForgeryToken()
                            @if (mode is "Edit" or "Delete")
                            {
                                @Html.HiddenFor(m => m.Id)
                            }
                            <div class="mb-2">
                                <table class="table table-sm align-middle">
                                    <tr>
                                        <td width="30%">First Name:<br /><input asp-for="FirstName" class="form-control input-compact" readonly="@(isReadOnly)" /></td>
                                        <td width="30%">Middle:<br /><input asp-for="MiddleName" class="form-control input-compact" readonly="@(isReadOnly)" /></td>
                                        <td>Last Name:<br /><input asp-for="LastName" class="form-control input-compact" readonly="@(isReadOnly)" /></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3">Display As:<br /><input asp-for="DisplayName" class="form-control input-compact" readonly="@(isReadOnly)" /></td>
                                    </tr>
                                    <tr>
                                        <td>Member Number:<br /><input asp-for="MemberNumber" class="form-control input-compact" readonly="@(isReadOnly)" /></td>
                                        <td>Start Date:<br />
                                            @if (isReadOnly)
                                            {
                                                <input type="text" class="form-control input-compact" value="@ShortDate(Model.MemberStartDate)" readonly />
                                            }
                                            else
                                            {
                                                <input asp-for="MemberStartDate" type="date" class="form-control input-compact" value="@IsoDate(Model.MemberStartDate)" />
                                            }
                                        </td>
                                        <td>Expires:<br />
                                            @if (isReadOnly)
                                            {
                                                <input type="text" class="form-control input-compact" value="@ShortDate(Model.MemberExpireDate)" readonly />
                                            }
                                            else
                                            {
                                                <input asp-for="MemberExpireDate" type="date" class="form-control input-compact" value="@IsoDate(Model.MemberExpireDate)" />
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Life Member Number:<br /><input asp-for="LifeMemberNumber" class="form-control input-compact" readonly="@(isReadOnly)" /></td>
                                        <td>Life Member Date:<br />
                                            @if (isReadOnly)
                                            {
                                                <input type="text" class="form-control input-compact" value="@ShortDate(Model.LifeMemberDate)" readonly />
                                            }
                                            else
                                            {
                                                <input asp-for="LifeMemberDate" type="date" class="form-control input-compact" value="@IsoDate(Model.LifeMemberDate)" />
                                            }
                                        </td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Address:<br /><input asp-for="PersonalAddress" class="form-control input-compact" readonly="@(isReadOnly)" /></td>
                                        <td>Phone:<br /><input asp-for="PersonalPhone" class="form-control input-compact" inputmode="tel" autocomplete="tel-national" data-phone="true" data-phone-normalize="digits" readonly="@(isReadOnly)" /></td>
                                        <td>Email:<br /><input asp-for="PersonalEmail" class="form-control input-compact" readonly="@(isReadOnly)" /></td>
                                    </tr>
                                    <tr>
                                        <td>Alternate Address:<br /><input asp-for="WorkAddress" class="form-control input-compact" readonly="@(isReadOnly)" /></td>
                                        <td>Alternate Phone:<br /><input asp-for="WorkPhone" class="form-control input-compact" inputmode="tel" autocomplete="tel-national" data-phone="true" data-phone-normalize="digits" readonly="@(isReadOnly)" /></td>
                                        <td>Alternate Email:<br /><input asp-for="WorkEmail" class="form-control input-compact" readonly="@(isReadOnly)" /></td>
                                    </tr>
                                    <tr>
                                        <td>Created:<br /><input type="text" class="form-control input-compact" value="@ShortDate(Model.CreatedDate)" readonly /></td>
                                        <td>Died:<br />
                                            @if (isReadOnly)
                                            {
                                                <input type="text" class="form-control input-compact" value="@ShortDate(Model.DiedOn)" readonly />
                                            }
                                            else
                                            {
                                                <input asp-for="DiedOn" type="date" class="form-control input-compact" value="@IsoDate(Model.DiedOn)" />
                                            }
                                        </td>
                                        <td>Authenticated:<br />
                                            <span class="badge @(Model.Authenticated ? "bg-success" : "bg-secondary")">
                                                @(Model.Authenticated ? "Yes" : "No")
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    @if (isAdmin)
    {
        @switch (popupType)
        {
            case mcl959mvc.Models.PopupType.Create:
            case mcl959mvc.Models.PopupType.Edit:
                <button type="submit" form="rosterPopup" class="btn btn-primary">Save</button>
                break;
            case mcl959mvc.Models.PopupType.Delete:
                <button type="submit" form="rosterPopup" class="btn btn-danger">Delete</button>
                break;
            case mcl959mvc.Models.PopupType.Details:
                <a href="#" class="btn btn-primary" data-popup="Edit" data-id="@Model.Id" data-popup-controller="Roster">Edit</a>
                <a href="#" class="btn btn-danger" data-popup="Delete" data-id="@Model.Id" data-popup-controller="Roster">Delete</a>
                break;
        }
    }
</div>
@functions {
    string? FormAction(mcl959mvc.Models.PopupType type, mcl959mvc.Models.Roster? m)
    {
        if (m == null) return "#";
        return type switch
        {
            mcl959mvc.Models.PopupType.Create => Url.Action("Create", "Roster"),
            mcl959mvc.Models.PopupType.Edit => Url.Action("Edit", "Roster", new { id = m.Id }),
            mcl959mvc.Models.PopupType.Delete => Url.Action("Delete", "Roster", new { id = m.Id }),
            _ => "#"
        };
    }
}