@model mcl959mvc.Models.EventsAndCommentsModel
@using System.IO
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http
@{
    var popupType  = (mcl959mvc.Models.PopupType)ViewBag.PopupType;
    var isAdmin    = (ViewBag.IsAdmin as bool?) ?? User.HasClaim("isAdmin", "true");
    var isReadOnly = popupType is mcl959mvc.Models.PopupType.Details or mcl959mvc.Models.PopupType.Delete;
    var fileName   = Model.Event.ImageFileName;
    var hasImage   = !string.IsNullOrWhiteSpace(fileName) && File.Exists(System.IO.Path.Combine(Env.WebRootPath, "images", fileName));
    var imagePath  = Url.Content(hasImage ? $"~/images/{fileName}" : "~/photos/mcl959bw.jpg");
    bool canComment = User.Identity?.IsAuthenticated == true && (User.HasClaim("isRegistered","true") || User.HasClaim("isAdmin","true"));

    // Event date/time values
    var eventDate = Model.Event.EventDate;
    var eventDateDisplay = eventDate.HasValue
        ? eventDate.Value.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")
        : "TBD";

    // Construct Google Calendar create-event URL when we have a date/time
    string gcalUrl = "#";
    if (eventDate.HasValue)
    {
        var startUtc = eventDate.Value.ToUniversalTime();
        var endUtc = startUtc.AddHours(1); // default 1 hour
        var s = startUtc.ToString("yyyyMMdd'T'HHmmss'Z'");
        var e = endUtc.ToString("yyyyMMdd'T'HHmmss'Z'");

        var gcalBase = "https://www.google.com/calendar/render?action=TEMPLATE";
        var title = Model.Event.EventName ?? "Event";
        var details = Model.Event.EventDescription ?? "";
        var scheme = Http.HttpContext.Request.Scheme;
        // use a distinct name so it doesn't collide with the outer 'eventUrl' variable
        var eventPageUrl = Url.RouteUrl("EventById", new { id = Model.Event.Id }, scheme) ?? string.Empty;

        gcalUrl = gcalBase
            + $"&text={Uri.EscapeDataString(title)}"
            + $"&dates={Uri.EscapeDataString(s)}/{Uri.EscapeDataString(e)}"
            + $"&details={Uri.EscapeDataString(details)}"
            + $"&location={Uri.EscapeDataString(eventPageUrl)}"
            + $"&ctz={Uri.EscapeDataString("America/Chicago")}";
    }

    var eventDateIso = (Model.Event.EventDate == null
        ? DateTime.UtcNow.ToString("yyyy-MM-dd")
        : Model.Event.EventDate.Value.ToString("yyyy-MM-dd"));

    // Absolute event URL (same as emails)
    var scheme2 = Http.HttpContext.Request.Scheme;
    var eventUrl = Url.RouteUrl("EventById", new { id = Model.Event.Id }, scheme2) ?? string.Empty;
    var eventUrlEsc = Uri.EscapeDataString(eventUrl);
    var shareText = Uri.EscapeDataString($"Check out this event: {Model.Event.EventName}");

    var mailSubject = Uri.EscapeDataString($"MCL959 Event: {Model.Event.EventName}");
    var mailBody = Uri.EscapeDataString($"Check this out: {eventUrl}");
    var mailtoHref = $"mailto:?subject={mailSubject}&body={mailBody}";
}

<div class="modal-body">
    <!-- Event data form -->
    <form id="popupForm"
          method="post"
          enctype="multipart/form-data"
          action="@FormAction(popupType, Model.Event)">
        @Html.AntiForgeryToken()
        @if (popupType != mcl959mvc.Models.PopupType.Create)
        {
            @Html.HiddenFor(m => m.Event.Id)
        }

        <div class="mb-2">
            <label class="form-label">Event Name</label>
            <input asp-for="Event.EventName" class="form-control" readonly="@isReadOnly" />
            <span asp-validation-for="Event.EventName" class="text-danger"></span>
        </div>

        @if (popupType == mcl959mvc.Models.PopupType.Create || popupType == mcl959mvc.Models.PopupType.Edit)
        {
            <div class="row gx-4 gy-3 align-items-start">
                <div class="col-12 col-md-6">
                    <label class="form-label">Event Image (existing)</label>
                    <select asp-for="Event.ImageFileName"
                            class="form-select"
                            disabled="@isReadOnly">
                        <option value="">-- Select an image --</option>
                        @if (ViewBag.Images is IEnumerable<string> imgs)
                        {
                            foreach (var img in imgs)
                            {
                                <option value="@img">@img</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">Upload New Image</label>
                    <input type="file"
                           name="ImageUpload"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.gif"
                           disabled="@isReadOnly" />
                    <small class="text-muted">Optional. Will be resized on upload.</small>
                </div>
            </div>
        }
        else
        {
            <!-- Equal-width 2 columns; stretch columns and let Share fill remaining height -->
            <div class="row gx-4 gy-3 align-items-stretch">
                <!-- Left column: Image -->
                <div id="event-image" class="col-12 col-md-6 d-flex">
                    <div class="w-100 text-center">
                        <img src="@imagePath"
                             alt="Event Image"
                             class="img-fluid rounded"
                             style="max-height:300px;border:1px solid #004392;" />
                    </div>
                </div>

                <!-- Right column: Date/Time, Calendar, then Share fills the gap -->
                <div class="col-12 col-md-6 d-flex flex-column">
                    <div id="date-time-picker" class="mb-3">
                        <label class="form-label">Date and Time</label>

                        @* Read-only view: show a link that opens Google Calendar create dialog *@
                        @if (isReadOnly)
                        {
                            @if (eventDate.HasValue)
                            {
                                <div>
                                    <a href="@gcalUrl" target="_blank" rel="noopener noreferrer">@eventDateDisplay</a>
                                </div>
                            }
                            else
                            {
                                <div>@eventDateDisplay</div>
                            }
                        }
                        else
                        {
                            @* Edit/Create: show editable datetime input (model binding) *@
                            <input asp-for="Event.EventDate" class="form-control" />
                            <span asp-validation-for="Event.EventDate" class="text-danger"></span>
                        }
                    </div>

                    <div id="event-calendar"
                         data-event-date="@eventDateIso"
                         data-event-name="@Model.Event.EventName"
                         class="mcl959-calendar mb-3 text-center w-100">
                    </div>

                </div>
                <!-- Share block BELOW the calendar; flex-grow makes it fill the remaining height -->
                <div class="border rounded p-2 flex-grow-1 d-flex flex-column">
                    <h6 class="mb-2">Share this event</h6>

                    <!-- Input + Copy on the same line -->
                    <div class="input-group mb-2">
                        <input type="text"
                                class="form-control"
                                value="@eventUrl"
                                readonly
                                aria-label="Event link" />
                        <button type="button"
                                class="btn btn-outline-secondary"
                                title="Copy link"
                                onclick="navigator.clipboard?.writeText('@eventUrl').then(()=>{this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',1500);});">
                            Copy Link
                        </button>
                    </div>

                    <!-- Facebook, X, Email on the same line -->
                    <div class="d-flex align-items-center gap-2 flex-nowrap mt-auto">
                        <a class="btn btn-sm btn-outline-primary flex-shrink-0"
                            target="_blank" rel="noopener"
                            href="https://www.facebook.com/sharer/sharer.php?u=@eventUrlEsc">
                            Share on Facebook
                        </a>
                        <a class="btn btn-sm btn-outline-info flex-shrink-0"
                            target="_blank" rel="noopener"
                            href="https://twitter.com/intent/tweet?text=@shareText&url=@eventUrlEsc">
                            Share on X (Twitter)
                        </a>
                        <a class="btn btn-sm btn-outline-secondary flex-shrink-0"
                            href="@mailtoHref">
                            Send via Email
                        </a>
                    </div>
                </div>
            </div>
        }

        <div class="mb-3">
            <label asp-for="Event.EventDescription" class="form-label">Description</label>
            <textarea asp-for="Event.EventDescription"
                      class="form-control"
                      rows="8"
                      disabled="@isReadOnly"></textarea>
            <span asp-validation-for="Event.EventDescription" class="text-danger"></span>
        </div>

        @if (popupType == mcl959mvc.Models.PopupType.Create || popupType == mcl959mvc.Models.PopupType.Edit)
        {
            <div class="row gx-4 gy-3 align-items-start">
                <div id="date-time-picker" class="col-12 col-md-6">
                    <label asp-for="Event.EventDate" class="form-label">Date and Time</label>
                    <input asp-for="Event.EventDate"
                           class="form-control"
                           disabled="@isReadOnly" />
                    <span asp-validation-for="Event.EventDate" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <input type="hidden" name="SubmissionId" value="@Guid.NewGuid()" />
                </div>
            </div>
        }
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    @if (isAdmin)
    {
        @switch (popupType)
        {
            case PopupType.Create:
            case PopupType.Edit:
                <button type="submit" form="popupForm" class="btn btn-primary">Save</button>
                break;
            case PopupType.Delete:
                <button type="submit" form="popupForm" class="btn btn-danger">Delete</button>
                break;
            case PopupType.Details:
                <a href="#"
                   class="btn btn-primary"
                   data-popup="Edit"
                   data-id="@Model.Event.Id"
                   data-popup-controller="Events">Edit</a>

                <form method="post"
                      action="@Url.Action("Delete", "Events", new { id = Model.Event.Id })"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Delete this event?');">
                        Delete
                    </button>
                </form>
                break;
        }
    }
</div>

<hr />

@if (Model.Comments?.Any() == true)
{
    <h5 class="mt-3">Comments</h5>
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th style="width:20%">User</th>
                <th style="width:55%">Message</th>
                <th style="width:20%">Time</th>
                <th style="width:5%"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Comments)
        {
            <tr>
                <td>@c.UserId</td>
                <td>@c.Message</td>
                <td>@c.TimeStamp.ToString("g")</td>
                <td class="text-end">
                    @if (isAdmin || User.Identity?.Name == c.UserId)
                    {
                        <form method="post"
                              action="@Url.Action("DeleteComment","Events", new { id = c.Id, parentId = Model.Event.Id })"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this comment?');">X</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No comments yet.</p>
}

@if (User.Identity?.IsAuthenticated == true && (User.HasClaim("isRegistered","true") || User.HasClaim("isAdmin","true")))
{
    <form id="commentForm" method="post" action="@Url.Action("AddComment","Events")" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SubmissionId" value="@Guid.NewGuid()" />
        <input type="hidden" name="TableSource" value="Events" />
        <input type="hidden" name="ParentId" value="@Model.Event.Id" />
        <div class="mb-2">
            <label class="form-label">Comment As</label>
            <input type="text" name="UserId" class="form-control" value="@User.Identity?.Name" />
        </div>
        <div class="mb-2">
            <label class="form-label">Comment</label>
            <textarea name="Message" class="form-control" rows="4" required></textarea>
        </div>
        <button type="submit" class="btn btn-secondary">Post Comment</button>
    </form>
}

@functions {
    string FormAction(mcl959mvc.Models.PopupType type, mcl959mvc.Models.EventsModel m)
    {
        return type switch
        {
            mcl959mvc.Models.PopupType.Create => Url.Action("Create", "Events"),
            mcl959mvc.Models.PopupType.Edit => Url.Action("Edit", "Events", new { id = m.Id }),
            mcl959mvc.Models.PopupType.Delete => Url.Action("Delete", "Events", new { id = m.Id }),
            _ => "#"
        };
    }
}