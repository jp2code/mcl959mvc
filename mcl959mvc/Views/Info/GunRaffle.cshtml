@{
    ViewData["Title"] = "Gun Raffle";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Event Details
    var title = "2026 Gun Raffle";
    var details = "Marine Corps League gun raffle drawing date";

    // Location broken out as plain text (do not embed a URL inside the location field)
    var storeName = "Superior Outfitters";
    var storeAddress = "1310 W Loop 281, Longview, TX 75604";
    var location = $"{storeName}, {storeAddress}";

    // Times: event is 20 Dec 2026 at 2:00 PM CST
    // Convert to UTC for the calendar (CST is UTC-6). 2:00 PM CST == 20:00Z on same day.
    var startDate = "20261220T200000Z"; // 2:00 PM CST -> 8:00 PM UTC
    var endDate = "20261220T210000Z";   // 3:00 PM CST -> 9:00 PM UTC

    // Construct a Google Calendar "create event" URL (use action=TEMPLATE)
    var gcalBase = "https://www.google.com/calendar/render?action=TEMPLATE";
    var gcalUrl = gcalBase +
                  $"&text={Uri.EscapeDataString(title)}" +
                  $"&dates={Uri.EscapeDataString(startDate)}/{Uri.EscapeDataString(endDate)}" +
                  $"&details={Uri.EscapeDataString(details)}" +
                  $"&location={Uri.EscapeDataString(location)}" +
                  $"&ctz={Uri.EscapeDataString("America/Chicago")}";

    // Construct a Google Maps search URL using the search API
    var searchQuery = $"{storeName} {storeAddress}";
    var mapsUrl = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(searchQuery)}";

    var contactName = "David Looney";
    var position = "2026 Gun Raffle Chairman";
    var rawPhoneNumber = "+19032610871"; // Best format for system routing
    var displayPhoneNumber = "(903) 261-0871"; // Best format for human reading
    // --- Payment links & QR codes (ticket = $50) ---
    // PayPal: use a simple Buy Now URL (business email); item name encoded
    var paypalUrl = "https://www.paypal.com/cgi-bin/webscr?cmd=_xclick&business=joeswelding%40gmail.com&amount=50&currency_code=USD&item_name=2026+Gun+Raffle+Ticket";
    var paypalQr = $"https://api.qrserver.com/v1/create-qr-code/?size=240x240&data={Uri.EscapeDataString(paypalUrl)}";

    // Cash App: quick-pay URL (uses cashtag). Many users can open this in browser or app.
    var cashAppUrl = "https://cash.app/$jp2code/50";
    var cashAppQr = $"https://api.qrserver.com/v1/create-qr-code/?size=240x240&data={Uri.EscapeDataString(cashAppUrl)}";

    // Venmo: web/URI for Venmo payment page with amount and note
    var venmoUrl = "https://venmo.com/jp2code1?txn=pay&amount=50&note=2026+Gun+Raffle+Ticket";
    var venmoQr = $"https://api.qrserver.com/v1/create-qr-code/?size=240x240&data={Uri.EscapeDataString(venmoUrl)}";

    // Google Pay & Apple Pay: recommend app/web flows; provide instruction links / QR to instructions
    // Google Pay: instruct to send $50 to tjpool@gmail.com inside the Google Pay app.
    var googlePayInfoUrl = "https://pay.google.com/about/"; // no simple universal "send to email" web link
    var googlePayQr = $"https://api.qrserver.com/v1/create-qr-code/?size=240x240&data={Uri.EscapeDataString(googlePayInfoUrl)}";

    // Apple Pay: must be integrated on-site (Stripe / provider) to offer web-based Apple Pay. Provide contact link.
    var applePayInfoUrl = "mailto:tjpool@gmail.com?subject=Apple%20Pay%20Ticket&body=Please%20send%20instructions%20to%20pay%20for%20a%20$50%20gun%20raffle%20ticket.";
    var applePayQr = $"https://api.qrserver.com/v1/create-qr-code/?size=240x240&data={Uri.EscapeDataString(applePayInfoUrl)}";

    // Other recommended option: Zelle (very common). Provide guidance link to Zelle and contact email
    var zelleInfoUrl = "https://www.zellepay.com/";
    var zelleQr = $"https://api.qrserver.com/v1/create-qr-code/?size=240x240&data={Uri.EscapeDataString(zelleInfoUrl)}";
}
<h2>Gun Raffle</h2>
<p>
    The 2026 Gun Raffle is being held to raise money for building maintenance.
    <ul>
        <li>This year, we have 15 guns up for drawing.</li>
        <li>Each ticket gets you 15 chances to win.</li>
        <li>Only 400 tickets are available to increase your odds of winning.</li>
        <li>One ticket can win multiple times. One ticket could win all 15 items.</li>
    </ul>
</p>
<center><img src="~/images/gunRaffle2026.png" style="width:80%" /></center>
<blockquote>
    <ul>
        <li><b>NOTE: </b>You do not have to be present to win, but you must be eligible to legally purchase a firearm.</li>
        <li><b>Date: </b>The drawing will be held <a href="@gcalUrl" target="_blank" rel="noopener noreferrer">20 December at 2:00 PM CST</a>.</li>
        <li>
            <b>Location: </b>The drawing will be held at
            <a href="@mapsUrl" target="_blank" rel="noopener noreferrer">
                @storeName<br />
                @storeAddress <br />
            </a>
            Any remaining tickets can be bought at that time during the drawing until the last ticket is drawn.
        </li>
        <li>
            <b>Tickets: </b>To purchase tickets, contact any Marine Corps League Longview Detachment 959 member or use the information below:
            <div class="contact-card">
                <h5>@contactName</h5>
                <p class="text-muted">@position</p>
                <ul>
                    <li>
                        <strong>Phone:</strong>
                        <a href="tel:@rawPhoneNumber">@displayPhoneNumber</a>
                    </li>
                    <li>
                        <strong>SMS:</strong>
                        <a href="sms:@rawPhoneNumber">Send a text message</a>
                    </li>
                </ul>
            </div>
        </li>
        <li>
            <h4>Online payment options (one ticket = $50)</h4>
            <p class="text-muted">Tap/click a method to open the payment page, or scan the QR code with your phone camera. Payment will go to the web sergeant and he will supply you with your ticket number.</p>

            <div style="display:flex;flex-wrap:wrap;gap:1rem;">
                <div style="width:220px;border:1px solid #ddd;padding:0.5rem;text-align:center;">
                    <strong>PayPal</strong>
                    <div style="margin:0.5rem 0;">
                        <a href="@paypalUrl" target="_blank" rel="noopener noreferrer">
                            <img src="@paypalQr" alt="PayPal QR: pay $50" style="width:180px;height:180px" />
                        </a>
                    </div>
                    <div><a href="@paypalUrl" target="_blank" rel="noopener noreferrer">Pay $50 with PayPal</a></div>
                </div>

                <div style="width:220px;border:1px solid #ddd;padding:0.5rem;text-align:center;">
                    <strong>Cash App</strong>
                    <div style="margin:0.5rem 0;">
                        <a href="@cashAppUrl" target="_blank" rel="noopener noreferrer">
                            <img src="@cashAppQr" alt="Cash App QR: pay $50" style="width:180px;height:180px" />
                        </a>
                    </div>
                    <div><a href="@cashAppUrl" target="_blank" rel="noopener noreferrer">Pay $50 via Cash App ($jp2code)</a></div>
                </div>

                <div style="width:220px;border:1px solid #ddd;padding:0.5rem;text-align:center;">
                    <strong>Venmo</strong>
                    <div style="margin:0.5rem 0;">
                        <a href="@venmoUrl" target="_blank" rel="noopener noreferrer">
                            <img src="@venmoQr" alt="Venmo QR: pay $50" style="width:180px;height:180px" />
                        </a>
                    </div>
                    <div><a href="@venmoUrl" target="_blank" rel="noopener noreferrer">Pay $50 to @@jp2code1 on Venmo</a></div>
                </div>

                <div style="width:220px;border:1px solid #ddd;padding:0.5rem;text-align:center;">
                    <strong>Google Pay</strong>
                    <div style="margin:0.5rem 0;">
                        <a href="@googlePayInfoUrl" target="_blank" rel="noopener noreferrer">
                            <img src="@googlePayQr" alt="Google Pay info QR" style="width:180px;height:180px" />
                        </a>
                    </div>
                    <div>
                        <small>Open Google Pay app and send $50 to <b>tjpool@gmail.com</b></small><br />
                        <a href="@googlePayInfoUrl" target="_blank" rel="noopener noreferrer">Google Pay help</a>
                    </div>
                </div>

                <div style="width:220px;border:1px solid #ddd;padding:0.5rem;text-align:center;">
                    <strong>Apple Pay</strong>
                    <div style="margin:0.5rem 0;">
                        <a href="@applePayInfoUrl" target="_blank" rel="noopener noreferrer">
                            <img src="@applePayQr" alt="Contact for Apple Pay" style="width:180px;height:180px" />
                        </a>
                    </div>
                    <div>
                        <small>Apple Pay on the web requires site integration (Stripe/processor).</small><br />
                        <a href="@applePayInfoUrl" target="_blank" rel="noopener noreferrer">Request Apple Pay instructions</a>
                    </div>
                </div>

                <div style="width:220px;border:1px solid #ddd;padding:0.5rem;text-align:center;">
                    <strong>Zelle (recommended)</strong>
                    <div style="margin:0.5rem 0;">
                        <a href="@zelleInfoUrl" target="_blank" rel="noopener noreferrer">
                            <img src="@zelleQr" alt="Zelle info QR" style="width:180px;height:180px" />
                        </a>
                    </div>
                    <div><small>Use your bank's Zelle feature and send $50 to the Web Sergeant's registered email (ask via contact).</small></div>
                </div>
            </div>

            <p style="margin-top:0.75rem;">
                Questions about payments? Email the Web Sergeant Joe Pool directly using <a href="mailto:joeswelding@gmail.com">joeswelding@gmail.com</a> or <a href="mailto:tjpool@gmail.com">tjpool@gmail.com</a>.
            </p>
        </li>
    </ul>
</blockquote>

