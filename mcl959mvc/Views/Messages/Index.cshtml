@model IEnumerable<mcl959mvc.Models.MessagesModel>
@{
    ViewData["Title"] = "Emails";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isAdmin = User.HasClaim("isAdmin", "true");
}

<h2>Email History</h2>

<p>
    <a href="#" data-popup="Create" data-popup-controller="Messages">New Message</a>
</p>
@if (isAdmin)
{
    <table class="table">
        <thead>
            <tr>
                <th>Sender</th>
                <th>Email</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <a href="#" data-popup="Details" data-id="@item.Id" data-popup-controller="Messages">@item.Name</a>
                    </td>
                    <td>
                        <a href="#" data-popup="Details" data-id="@item.Id" data-popup-controller="Messages">@item.Email</a>
                    </td>
                    <td>
                        <a href="#" data-popup="Details" data-id="@item.Id" data-popup-controller="Messages">@item.Date</a>
                    </td>
                    <td>
                        <a href="#" data-popup="Edit" data-id="@item.Id" data-popup-controller="Messages">Edit</a> |
                        <a href="#" data-popup="Delete" data-id="@item.Id" data-popup-controller="Messages">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
<script>
$(function () {
    $('#miContact').addClass('selected');
});
</script>
