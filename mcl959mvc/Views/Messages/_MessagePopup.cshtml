@model mcl959mvc.Models.MessagesModel
@{
    var popupType = (mcl959mvc.Models.PopupType)ViewBag.PopupType;
    // prefer ViewBag first, fall back to claim
    var isAdmin = (ViewBag.IsAdmin as bool?) ?? User.HasClaim("isAdmin", "true");
    var isReadOnly = popupType is mcl959mvc.Models.PopupType.Details or mcl959mvc.Models.PopupType.Delete;
}

<div class="modal-body">
    @if (popupType == mcl959mvc.Models.PopupType.Delete)
    {
        <p>Are you sure you want to delete this message?</p>
    }
    <form id="popupForm" method="post" enctype="multipart/form-data" action="@FormAction(popupType, Model)">
        @Html.AntiForgeryToken()
        @if (popupType != mcl959mvc.Models.PopupType.Create)
        {
            @Html.HiddenFor(m => m.Id)
        }

        <div class="mb-2">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" readonly="@(isReadOnly ? "readonly" : null)" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-2">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" readonly="@(isReadOnly ? "readonly" : null)" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        @if (popupType != mcl959mvc.Models.PopupType.Delete)
        {
            <div class="mb-2">
                <label asp-for="SendTo" class="form-label"></label>
                <select asp-for="SendTo" asp-items="ViewBag.Recipients" class="form-select" disabled="@(isReadOnly ? "disabled" : null)"></select>
                <span asp-validation-for="SendTo" class="text-danger"></span>
            </div>
            <div class="mb-2">
                <label asp-for="Subject" class="form-label"></label>
                <input asp-for="Subject" class="form-control" readonly="@(isReadOnly ? "readonly" : null)" />
                <span asp-validation-for="Subject" class="text-danger"></span>
            </div>
            <div class="mb-2">
                <label asp-for="Comments" class="form-label"></label>
                <textarea asp-for="Comments" class="form-control" rows="4" readonly="@(isReadOnly ? "readonly" : null)"></textarea>
                <span asp-validation-for="Comments" class="text-danger"></span>
            </div>
        }
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    @if (popupType == mcl959mvc.Models.PopupType.Create)
    {
        <button type="submit" form="popupForm" class="btn btn-primary">Create</button>
    }
    else if (popupType == mcl959mvc.Models.PopupType.Edit)
    {
        <button type="submit" form="popupForm" class="btn btn-primary">Save</button>
    }
    else if (popupType == mcl959mvc.Models.PopupType.Delete)
    {
        <button type="submit" form="popupForm" class="btn btn-danger">Delete</button>
    }
</div>

@functions {
    string FormAction(mcl959mvc.Models.PopupType type, mcl959mvc.Models.MessagesModel m)
    {
        string v = type switch
        {
            mcl959mvc.Models.PopupType.Create => Url.Action("Create", "Messages"),
            mcl959mvc.Models.PopupType.Edit => Url.Action("Edit", "Messages", new { id = m.Id }),
            mcl959mvc.Models.PopupType.Delete => Url.Action("Delete", "Messages", new { id = m.Id }),
            _ => "#"
        };
        return v;
    }
}