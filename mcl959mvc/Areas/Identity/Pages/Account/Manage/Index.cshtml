@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="Username">Login Email</label>
                <input asp-for="Username" class="form-control" disabled />
            </div>

            <div class="form-group">
                <input asp-for="Input.GetEmailUpdates" class="form-check-input" />
                <label asp-for="Input.GetEmailUpdates" class="form-check-label"></label>
                <span asp-validation-for="Input.GetEmailUpdates" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.PhoneNumber">Phone Number</label>
                <input asp-for="Input.PhoneNumber"
                       class="form-control"
                       inputmode="tel"
                       autocomplete="tel"
                       data-phone="true" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            @if (Model.HasRosterMatch)
            {
                <div class="form-group">
                    <label asp-for="Input.PersonalAddress"></label>
                    <input asp-for="Input.PersonalAddress" class="form-control" />
                    <span asp-validation-for="Input.PersonalAddress" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.PersonalPhone">Personal Phone</label>
                    <input asp-for="Input.PersonalPhone"
                           class="form-control"
                           inputmode="tel"
                           autocomplete="tel-national"
                           data-phone="true" />
                    <span asp-validation-for="Input.PersonalPhone" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.WorkEmail"></label>
                    <input asp-for="Input.WorkEmail" class="form-control" />
                    <span asp-validation-for="Input.WorkEmail" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.WorkAddress"></label>
                    <input asp-for="Input.WorkAddress" class="form-control" />
                    <span asp-validation-for="Input.WorkAddress" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.WorkPhone"></label>
                    <input asp-for="Input.WorkPhone"
                           class="form-control"
                           inputmode="tel"
                           autocomplete="tel"
                           data-phone="true" />
                    <span asp-validation-for="Input.WorkPhone" class="text-danger"></span>
                </div>
            }

            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            function normalizeDigits(s) {
                if (!s) return "";
                var d = s.replace(/\D+/g, "");
                if (d.length === 11 && d[0] === "1") d = d.slice(1);
                return d;
            }
            function formatUS(d) {
                if (d.length !== 10) return null;
                return "(" + d.slice(0, 3) + ") " + d.slice(3, 6) + "-" + d.slice(6);
            }
            function onBlurFormat(e) {
                var el = e.target;
                var d = normalizeDigits(el.value);
                var f = formatUS(d);
                if (f) el.value = f; // display formatted if valid 10-digit
            }
            document.addEventListener("DOMContentLoaded", function () {
                var phones = document.querySelectorAll('input[data-phone="true"]');
                phones.forEach(function (el) {
                    // Format any prefilled value
                    var d = normalizeDigits(el.value);
                    var f = formatUS(d);
                    if (f) el.value = f;
                    el.addEventListener("blur", onBlurFormat, { passive: true });
                });
            });
        })();
    </script>
}
